# Copy to .env and change the values. .env is gitignored.
POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=change-me
# 5433 so it does not clash with a Postgres already running on 5432
POSTGRES_PORT=5433
REDIS_PORT=6379

# Backend (mirrors the database above). JWT_SECRET must be 32+ characters.
DB_URL=jdbc:postgresql://localhost:5433/ticketrush
DB_USER=ticketrush
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# Demo organizer for the dev profile (SPRING_PROFILES_ACTIVE=dev). Pick any password.
DEMO_ORGANIZER_PASSWORD=change-me-demo-organizer
