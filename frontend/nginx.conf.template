# The web app is static files plus a proxy for /api. The official nginx image fills in ${BACKEND} at start-up.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript image/svg+xml application/json;

  # Resolved when a request arrives, not when nginx starts, so the web container can start before the app.
  resolver 127.0.0.11 valid=10s;

  location /api/ {
    include /etc/nginx/security-headers.conf;
    set $backend ${BACKEND};
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The waiting room stream is a long-lived response: do not hold it back, and do not cut it off.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  # Built files have a hash in their name, so they can be kept for good. index.html must always be fetched fresh.
  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
