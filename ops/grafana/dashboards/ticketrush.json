{
 "uid": "ticketrush",
 "title": "TicketRush",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Requests per second, by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[15s]))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Latency p95, by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s])))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Latency p99, by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s])))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Errors per second (5xx) and rejected requests (4xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[15s]))",
     "legendFormat": "5xx",
     "refId": "A"
    },
    {
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{status=~\"4..\"}[15s]))",
     "legendFormat": "{{status}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Seat holds per second, by result",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (result) (rate(ticketrush_holds_total[15s]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "held: got the seats. seats_taken: someone else had at least one. rejected: refused before touching seats (no admission, bad request).",
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Waiting room: joins and admissions per second, and people still waiting",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(ticketrush_queue_joins_total[15s]))",
     "legendFormat": "joins/s",
     "refId": "A"
    },
    {
     "expr": "sum(rate(ticketrush_queue_admitted_total[15s]))",
     "legendFormat": "admitted/s",
     "refId": "B"
    },
    {
     "expr": "sum(ticketrush_queue_joins_total) - sum(ticketrush_queue_admitted_total)",
     "legendFormat": "still waiting (joined minus admitted)",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Orders per second, by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(ticketrush_orders_total[15s]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Payment provider call, p50 and p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(ticketrush_charge_seconds_bucket[30s])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ticketrush_charge_seconds_bucket[30s])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Database connections (pool)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "hikaricp_connections_active",
     "legendFormat": "active",
     "refId": "A"
    },
    {
     "expr": "hikaricp_connections_pending",
     "legendFormat": "waiting for a connection",
     "refId": "B"
    },
    {
     "expr": "hikaricp_connections_max",
     "legendFormat": "pool size",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Waiting for a connection above zero means requests are queueing for the database, not being slow in it.",
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Time to get a database connection, p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket[30s])))",
     "legendFormat": "p95 acquire",
     "refId": "A"
    },
    {
     "expr": "rate(hikaricp_connections_usage_seconds_sum[30s]) / rate(hikaricp_connections_usage_seconds_count[30s])",
     "legendFormat": "mean time a connection is held",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "process_cpu_usage",
